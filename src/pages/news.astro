---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const now = new Date();
const news = (await getCollection('articles', ({ data }) =>
  data.published !== false &&
  data.contentType === 'news' &&
  new Date(data.date) <= now
)).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Base
  title="Construction News for Contractors"
  description="Time-sensitive construction market reporting and Decision Briefings for contractors."
  keywords={['construction news', 'construction market intelligence', 'contractor news']}
  breadcrumbs={[
    { name: 'Home', url: 'https://scalinglegends.com/' },
    { name: 'News', url: 'https://scalinglegends.com/news' },
  ]}
>
  <section class="relative px-8 py-20 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full opacity-20 pointer-events-none" style="background: radial-gradient(circle, rgba(204,255,0,0.15) 0%, transparent 70%);"></div>
    <div class="relative z-10 mx-auto max-w-4xl">
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm">
        <a href="/" class="text-[#888888] hover:text-[#CCFF00] transition-colors no-underline">Home</a><span class="text-[#444444]">/</span><span class="text-[#999999]">News</span>
      </nav>
      <div class="inline-flex px-4 py-2 border border-[#CCFF00]/40 bg-[#CCFF00]/5 rounded-lg mb-6 text-[#CCFF00] uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: .12em;">Construction news</div>
      <h1 class="text-[#EAEAEA] uppercase mb-4" style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 900; letter-spacing: -.04em; line-height: .95;">News that changes your next move.</h1>
      <p class="text-[#A8A8A8] max-w-3xl" style="font-size: 1.0625rem; line-height: 1.7;">Current construction reporting and Decision Briefings. Evergreen playbooks stay in Articles, so this feed is reserved for time-sensitive market developments.</p>
    </div>
  </section>

  <section class="px-8 pb-24 bg-gradient-to-b from-[#0D0D0D] to-[#000000]">
    <div class="mx-auto">
      {news.length === 0 ? (
        <p class="text-[#888888] py-16 text-center">Fresh construction news is being prepared. Check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {news.map((article) => (
            <article class="group bg-[#161616] border border-[#222222] rounded-2xl overflow-hidden transition-all duration-300 hover:border-[#CCFF00] hover:-translate-y-1">
              {article.data.image && <a href={`/article/${article.id}/`} class="block h-[180px] bg-[#0D0D0D] flex items-center justify-center"><img src={article.data.image} alt={article.data.title} class="max-w-full max-h-full object-contain" loading="lazy" width="400" height="180" /></a>}
              <div class="p-7">
                <div class="text-[#CCFF00] uppercase mb-3" style="font-size: 11px; font-weight: 700; letter-spacing: .1em;">News · {new Date(article.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                <h2 class="text-[#EAEAEA] mb-3" style="font-size: 1.25rem; font-weight: 700; line-height: 1.3;"><a href={`/article/${article.id}/`} class="text-inherit no-underline group-hover:text-[#CCFF00] transition-colors">{article.data.title}</a></h2>
                <p class="text-[#888888] line-clamp-3" style="font-size: .9375rem; line-height: 1.6;">{article.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
